{
  "name": "wangchan-dorm-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n wrangler,vite \"wrangler dev\" \"vite dev\"",
    "predev": "npm run db:migrate:local && npm run build",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "db:migrate:local": "wrangler d1 migrations apply wangchan-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply wangchan-demo --remote",
    "deploy": "npm run build && wrangler deploy && npm run db:migrate:remote"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
